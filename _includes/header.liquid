{%- comment -%}
  상단 메뉴. 메뉴 항목은 _data/navigation.yml, 로고 글자는 _data/lab.yml, 버튼 문구는 _data/strings.yml
{%- endcomment -%}
{%- assign lab = site.data.lab -%}
{%- assign t = site.data.strings.common -%}
<nav class="topnav" id="topnav" aria-label="{{ t.main_navigation | escape }}">
  <div class="brand-pair">
    <a class="university-brand" href="https://www.postech.ac.kr/" aria-label="POSTECH main website"><img src="{{ '/assets/img/postech-logo.png' | relative_url }}" alt="POSTECH" width="160" height="38"></a>
    <a class="brand lab-brand" href="{{ '/' | relative_url }}" aria-label="Kim Group home"><img src="{{ '/assets/img/kim-group-logo.png' | relative_url }}" alt="KIM GROUP" width="99" height="19"><span>{{ t.at }} {{ lab.institution }}</span></a>
  </div>
  <button class="nav-toggle" aria-label="{{ t.open_menu | escape }}" aria-controls="main-menu" aria-expanded="false" data-label-open="{{ t.open_menu | escape }}" data-label-close="{{ t.close_menu | escape }}">
    <span></span><span></span><span></span>
  </button>
  <ul id="main-menu">
    {%- for item in site.data.navigation %}
    {%- assign is_current = false -%}
    {%- if page.url == item.url -%}{%- assign is_current = true -%}{%- endif -%}
    {%- for child in item.children -%}
      {%- if page.url == child.url -%}{%- assign is_current = true -%}{%- endif -%}
    {%- endfor %}
    <li{% if is_current %} class="current"{% endif %}>
      <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
      {%- if item.children %}
      <ul class="submenu">
        {%- for child in item.children %}
        <li><a href="{{ child.url | relative_url }}">{{ child.title }}</a></li>
        {%- endfor %}
      </ul>
      {%- endif %}
    </li>
    {%- endfor %}
  </ul>
</nav>
