{%- comment -%} 푸터. 내용은 _data/lab.yml 에서 가져옵니다. {%- endcomment -%}
{%- assign lab = site.data.lab -%}
<footer class="site-footer"><div><a class="brand" href="{{ '/' | relative_url }}">{{ lab.short_name }} <span>{{ site.data.strings.common.at }} {{ lab.institution }}</span></a><p>{{ lab.full_name | escape }}</p></div><div>{% include lab-email-link.liquid %}<p>{{ lab.department | escape }} · {{ lab.institution | escape }}<br>{{ lab.location | escape }}</p></div></footer>
